# Facultatif : copier en .env (ignoré par Git) à côté de compose.yml pour personnaliser.
# Les mots de passe PostgreSQL ne sont appliqués qu'à la création du volume postgres_data
# (docker compose down -v pour réinitialiser).
MLFLOW_PORT=5050
PREFECT_PORT=4250
GRAFANA_PORT=3030
POSTGRES_PORT=5433

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=5mlde-projet-admin

POSTGRES_PASSWORD=5mlde-projet-postgres
API_DB_PASSWORD=5mlde-projet-api
GRAFANA_DB_PASSWORD=5mlde-projet-grafana
PREFECT_DB_PASSWORD=5mlde-projet-prefect
