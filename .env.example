# Copier en .env (ignoré par Git) à la racine : lu par docker compose ET par le code Python
# (connectors.config). Les mots de passe PostgreSQL ne sont appliqués qu'à la création du
# volume postgres_data (docker compose down -v pour réinitialiser).

# --- Ports hôte (docker compose) -------------------------------------------------------------
MLFLOW_PORT=5000
PREFECT_PORT=4200
GRAFANA_PORT=3000
POSTGRES_PORT=5432
API_PORT=8000
APP_PORT=8501

# --- Mots de passe (docker compose + code) ---------------------------------------------------
POSTGRES_PASSWORD=5mlde-project-postgres
API_DB_PASSWORD=5mlde-project-api
GRAFANA_DB_PASSWORD=5mlde-project-grafana
PREFECT_DB_PASSWORD=5mlde-project-prefect
MLFLOW_DB_PASSWORD=5mlde-project-mlflow
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=5mlde-project-admin

# --- Adresses des services vues par le code Python (obligatoires, sans défaut) ---------------
MLFLOW_TRACKING_URI=http://localhost:5000
# MLFLOW_REGISTRY_URI=           # défaut : MLFLOW_TRACKING_URI
MLFLOW_EXPERIMENT_NAME=5mlde-project
PREFECT_API_URL=http://localhost:4200/api
GRAFANA_URL=http://localhost:3000
# GRAFANA_TOKEN=                 # jeton de compte de service, prioritaire sur le compte admin
POSTGRES_HOST=localhost
# API_DB_NAME=mlops  API_DB_USER=api_writer  API_DB_POOL_MIN=1  API_DB_POOL_MAX=5  API_DB_TIMEOUT_S=5

# --- Données (ingestion) ---------------------------------------------------------------------
# DATA_DIR=data                  # historique Parquet (relatif à la racine du projet)
# CANDLES_RETENTION_DAYS=45      # fenêtre des bougies récentes dans market.candles
