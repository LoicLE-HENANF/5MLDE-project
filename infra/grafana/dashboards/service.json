    {
      "id": 5,
      "type": "timeseries",
      "title": "Prévision du champion et référence naïve",
      "description": "Prévision faite à la clôture de chaque bougie (horizon du modèle), référence naïve en pointillés.",
      "datasource": {
        "uid": "projet-traces"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "projet-traces"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT open_time AS time, symbol || ' prévision' AS metric, prediction AS value FROM tracing.predictions WHERE model_name = '$modele' AND mode = '$mode' AND alias = 'champion' AND symbol IN ($symbole) AND $__timeFilter(open_time) UNION ALL SELECT open_time, symbol || ' référence', baseline FROM tracing.predictions WHERE model_name = '$modele' AND mode = '$mode' AND alias = 'champion' AND baseline IS NOT NULL AND symbol IN ($symbole) AND $__timeFilter(open_time) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "always",
            "pointSize": 6,
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*référence"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
