      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "projet-traces"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT DISTINCT ON (symbol, alias) symbol AS \"symbole\", alias, version, open_time AS \"bougie\", horizon_hours AS \"horizon (h)\", prediction AS \"prévision\", baseline AS \"référence\", position, recorded_at AS \"écrite le\" FROM tracing.predictions WHERE model_name = '$modele' AND mode = '$mode' ORDER BY symbol, alias, open_time DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
