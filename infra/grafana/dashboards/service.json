      {
        "name": "Repères registre",
        "datasource": {
          "uid": "projet-traces"
        },
        "enable": true,
        "iconColor": "purple",
        "target": {
          "refId": "A",
          "datasource": {
            "uid": "projet-traces"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT event_time AS time, text, tags FROM (SELECT COALESCE((details->>'as_of')::timestamptz, recorded_at) AS event_time, event || COALESCE(' ' || alias, '') || ' v' || version AS text, 'registre' AS tags FROM tracing.model_events WHERE model_name = '$modele' || CASE WHEN '$mode' = 'replay' THEN '-replay' ELSE '' END) e WHERE $__timeFilter(event_time)"
        },
        "rawQuery": "SELECT event_time AS time, text, tags FROM (SELECT COALESCE((details->>'as_of')::timestamptz, recorded_at) AS event_time, event || COALESCE(' ' || alias, '') || ' v' || version AS text, 'registre' AS tags FROM tracing.model_events WHERE model_name = '$modele' || CASE WHEN '$mode' = 'replay' THEN '-replay' ELSE '' END) e WHERE $__timeFilter(event_time)"
      },
      {
        "name": "Repères marche / arrêt",
        "datasource": {
          "uid": "projet-traces"
        },
        "enable": true,
        "iconColor": "orange",
        "target": {
          "refId": "A",
          "datasource": {
            "uid": "projet-traces"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT recorded_at AS time, CASE WHEN active THEN 'Marche' ELSE 'Arrêt' END || ' (' || changed_by || ') : ' || reason AS text, 'systeme' AS tags FROM tracing.system_changes WHERE $__timeFilter(recorded_at)"
        },
        "rawQuery": "SELECT recorded_at AS time, CASE WHEN active THEN 'Marche' ELSE 'Arrêt' END || ' (' || changed_by || ') : ' || reason AS text, 'systeme' AS tags FROM tracing.system_changes WHERE $__timeFilter(recorded_at)"
      }
    ]
  },
