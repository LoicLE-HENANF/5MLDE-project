          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT EXTRACT(EPOCH FROM now() - max(recorded_at)) AS \"âge\" FROM tracing.predictions WHERE model_name = '$modele' AND mode = '$mode'"
