          "rawSql": "SELECT count(*) AS \"retours\" FROM tracing.feedback f JOIN tracing.predictions p ON p.id = f.prediction_id WHERE p.model_name = '$modele' AND p.mode = '$mode' AND $__timeFilter(f.recorded_at)"
