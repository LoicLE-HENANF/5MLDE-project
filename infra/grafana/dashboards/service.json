    {
      "id": 8,
      "type": "timeseries",
      "title": "Perte quotidienne des retours",
      "description": "Perte moyenne par jour de prévision, plus bas = mieux (QLIKE pour la volatilité, erreur quadratique pour le rendement).",
      "datasource": {
        "uid": "projet-traces"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "projet-traces"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(p.open_time, '1d'), p.alias || ' v' || p.version AS metric, avg(f.loss) AS value FROM tracing.feedback f JOIN tracing.predictions p ON p.id = f.prediction_id WHERE p.model_name = '$modele' AND p.mode = '$mode' AND p.symbol IN ($symbole) AND $__timeFilter(p.open_time) GROUP BY 1, 2 UNION ALL SELECT $__timeGroupAlias(p.open_time, '1d'), 'référence', avg(f.baseline_loss) FROM tracing.feedback f JOIN tracing.predictions p ON p.id = f.prediction_id WHERE p.model_name = '$modele' AND p.mode = '$mode' AND p.alias = 'champion' AND p.symbol IN ($symbole) AND $__timeFilter(p.open_time) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "always",
            "pointSize": 6,
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "référence"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
