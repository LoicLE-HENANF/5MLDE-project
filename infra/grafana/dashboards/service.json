          "datasource": {
            "uid": "projet-traces"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT version AS \"version\" FROM tracing.predictions WHERE model_name = '$modele' AND mode = '$mode' AND alias = 'champion' ORDER BY id DESC LIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
