    {
      "id": 7,
      "type": "barchart",
      "title": "Latence p95 sur la rampe",
      "description": "p95 de chaque palier de la rampe, par configuration ; la rampe s'arrête au premier palier hors SLO.",
      "datasource": {
        "uid": "projet-traces"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "projet-traces"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT (r->>'bots')::int::text AS \"bots\", max((r->>'p95_ms')::float) FILTER (WHERE workers || 'w / ' || rtrim(rtrim(cpus::text, '0'), '.') || ' CPU' = '1w / 0.5 CPU') AS \"1w / 0.5 CPU\" , max((r->>'p95_ms')::float) FILTER (WHERE workers || 'w / ' || rtrim(rtrim(cpus::text, '0'), '.') || ' CPU' = '2w / 0.5 CPU') AS \"2w / 0.5 CPU\" , max((r->>'p95_ms')::float) FILTER (WHERE workers || 'w / ' || rtrim(rtrim(cpus::text, '0'), '.') || ' CPU' = '4w / 0.5 CPU') AS \"4w / 0.5 CPU\" , max((r->>'p95_ms')::float) FILTER (WHERE workers || 'w / ' || rtrim(rtrim(cpus::text, '0'), '.') || ' CPU' = '1w / 1 CPU') AS \"1w / 1 CPU\" , max((r->>'p95_ms')::float) FILTER (WHERE workers || 'w / ' || rtrim(rtrim(cpus::text, '0'), '.') || ' CPU' = '2w / 1 CPU') AS \"2w / 1 CPU\" , max((r->>'p95_ms')::float) FILTER (WHERE workers || 'w / ' || rtrim(rtrim(cpus::text, '0'), '.') || ' CPU' = '4w / 1 CPU') AS \"4w / 1 CPU\" FROM tracing.load_tests, jsonb_array_elements(details->'ramp') r WHERE campaign = '$campagne' AND scenario = 'rupture' GROUP BY (r->>'bots')::int ORDER BY (r->>'bots')::int"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1
          },
          "unit": "ms"
