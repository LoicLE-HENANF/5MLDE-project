    {
      "id": 10,
      "type": "table",
      "title": "Résultats de la campagne",
      "description": "Rupture : dernier palier de la rampe tenant le SLO (premier palier si aucun).",
      "datasource": {
        "uid": "projet-traces"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "projet-traces"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT workers || 'w / ' || rtrim(rtrim(cpus::text, '0'), '.') || ' CPU' AS \"configuration\", scenario AS \"scénario\", users AS \"utilisateurs\", round(rps::numeric, 1) AS \"req/s\", round(p50_ms::numeric) AS \"p50 (ms)\", round(p95_ms::numeric) AS \"p95 (ms)\", round(p99_ms::numeric) AS \"p99 (ms)\", round((100.0 * failures / NULLIF(requests, 0))::numeric, 2) AS \"erreurs (%)\", round(api_cpu_pct::numeric) AS \"CPU api (%)\", round(api_mem_mb::numeric) AS \"mém. api (Mio)\", round(pg_cpu_pct::numeric) AS \"CPU postgres (%)\", CASE WHEN slo_ok THEN 'tenu' ELSE 'hors SLO' END AS \"SLO\", CASE WHEN recommended THEN 'oui' ELSE '' END AS \"recommandée\" FROM tracing.load_tests WHERE campaign = '$campagne' ORDER BY cpus, workers, array_position(ARRAY['normal', 'pic', 'rupture'], scenario)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "SLO"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "tenu": {
                        "color": "green",
                        "index": 0
                      },
                      "hors SLO": {
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "recommandée"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "oui": {
                        "color": "blue",
                        "index": 0
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
