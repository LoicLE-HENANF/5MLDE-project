          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT workers || 'w / ' || rtrim(rtrim(cpus::text, '0'), '.') || ' CPU' AS \"configuration\" FROM tracing.load_tests WHERE campaign = '$campagne' AND recommended AND scenario = 'rupture' LIMIT 1"
