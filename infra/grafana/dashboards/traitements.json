      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "projet-prefect"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT fr.start_time AS \"début\", f.name AS flow, d.name AS \"déploiement\", fr.state_name AS \"état\", round(EXTRACT(EPOCH FROM fr.total_run_time)::numeric, 1) AS \"durée (s)\", fr.name AS run FROM flow_run fr JOIN flow f ON f.id = fr.flow_id LEFT JOIN deployment d ON d.id = fr.deployment_id WHERE $__timeFilter(fr.start_time) ORDER BY fr.start_time DESC LIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
