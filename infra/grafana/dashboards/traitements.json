          "rawSql": "SELECT $__timeGroupAlias(start_time, '1h'), state_type AS metric, count(*) AS value FROM flow_run WHERE start_time IS NOT NULL AND $__timeFilter(start_time) GROUP BY 1, 2 ORDER BY 1"
