    {
      "id": 5,
      "type": "timeseries",
      "title": "Durée des flows",
      "description": "",
      "datasource": {
        "uid": "projet-prefect"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "projet-prefect"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT fr.start_time AS time, f.name AS metric, EXTRACT(EPOCH FROM fr.total_run_time) AS value FROM flow_run fr JOIN flow f ON f.id = fr.flow_id WHERE fr.start_time IS NOT NULL AND $__timeFilter(fr.start_time) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "always",
            "pointSize": 6,
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
