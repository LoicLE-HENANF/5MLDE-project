        {"de": "feedback", "vers": "mlflow", "label": "retour arrière", "style": "pointille"},
        {"de": "predictions", "vers": "api"},
        {"de": "health", "vers": "api"},
        {"de": "mlflow", "vers": "api"},
        {"de": "predictions", "vers": "grafana"},
        {"de": "health", "vers": "grafana"},
        {"de": "batches", "vers": "grafana"}
      ]
    },
    {
      "id": "modeles", "hauteur": 700,
      "direction": "TB",
      "ligne": "parcours",
      "titre": "Modèles et promotion",
      "legende": "Pointillés : promotion manuelle et retour arrière automatique.",
      "groupes": [
        {"id": "volatilite", "label": "volatilite : volatilité réalisée 24 h (QLIKE)"},
        {"id": "rendement", "label": "rendement : rendement 4 h (IC)"}
      ],
      "noeuds": [
        {"id": "candidats", "label": "Candidats\nRidge, HistGradientBoosting", "groupe": "volatilite"},
        {"id": "refs", "label": "Références naïves\npersistance, semaine, moyenne", "groupe": "volatilite"},
        {"id": "folds", "label": "Folds walk-forward\nembargo + purge", "groupe": "volatilite"},
        {"id": "choix", "label": "Meilleur QLIKE moyen\nréentraîné hors test final", "groupe": "volatilite"},
        {"id": "test", "label": "Test final\n3 derniers mois, une seule fois", "groupe": "volatilite"},
        {"id": "rendement", "label": "Ridge, HistGradientBoosting\nvs zéro et momentum, IC moyen", "groupe": "rendement"},
        {"id": "regle", "label": "Règle de promotion\nniveau 1 : bat les références\nniveau 2 : stratégie bat la persistance\net bat le champion actuel", "type": "decision"},
        {"id": "refuse", "label": "non enregistré"},
        {"id": "challenger", "label": "alias challenger\nprédit en parallèle"},
        {"id": "champion", "label": "alias champion\nposition servie", "type": "succes"},
        {"id": "precedent", "label": "alias precedent\nancien champion"},
        {"id": "sante", "label": "Santé quotidienne\nQLIKE glissante vs persistance"}
      ],
      "liens": [
        {"de": "candidats", "vers": "folds"},
        {"de": "refs", "vers": "folds"},
        {"de": "folds", "vers": "choix"},
        {"de": "choix", "vers": "test"},
        {"de": "test", "vers": "regle"},
        {"de": "rendement", "vers": "regle"},
        {"de": "regle", "vers": "refuse", "label": "niveau 1 échoue"},
        {"de": "regle", "vers": "challenger", "label": "niveau 2 échoue"},
        {"de": "regle", "vers": "champion", "label": "tout passe"},
        {"de": "challenger", "vers": "champion", "label": "promotion manuelle\n(raison tracée)", "style": "pointille"},
        {"de": "champion", "vers": "precedent", "label": "remplacé"},
        {"de": "champion", "vers": "sante"},
        {"de": "sante", "vers": "precedent", "label": "3 jours dégradés :\nretour arrière", "style": "pointille"}
      ]
    },
    {
