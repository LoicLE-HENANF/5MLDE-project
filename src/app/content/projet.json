        {"de": "candles", "vers": "features"},
        {"de": "features", "vers": "train"},
        {"de": "train", "vers": "mlflow"},
        {"de": "mlflow", "vers": "predict", "label": "alias"},
        {"de": "features", "vers": "predict"},
        {"de": "predict", "vers": "predictions"},
        {"de": "predictions", "vers": "feedback"},
