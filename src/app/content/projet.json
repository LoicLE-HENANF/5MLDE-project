{
  "titre": "Projet de 5MLDE",
  "sous_titre": "Prévision du risque crypto, de la donnée brute au modèle servi",
  "sujet": {
    "intro": "Industrialiser la **prévision du risque** de 5 cryptomonnaies (BTCUSDT, ETHUSDT, SOLUSDT, BNBUSDT, XRPUSDT), à partir des bougies horaires Binance spot depuis janvier 2022.",
    "modeles": [
      {
        "nom": "volatilite",
        "cible": "Volatilité réalisée",
        "horizon": "24 h",
        "metrique": "QLIKE (plus bas = mieux)",
        "usage": "Ciblage de volatilité : la taille des positions s'ajuste au risque prévu.",
        "references": "Persistance 24 h, volatilité de la semaine, moyenne par symbole"
      },
      {
        "nom": "rendement",
        "cible": "Rendement",
        "horizon": "4 h",
        "metrique": "IC, corrélation de rang (plus haut = mieux)",
        "usage": "Stratégie long/short : achat des symboles les mieux classés, vente des moins bien classés.",
        "references": "Prédiction nulle, momentum"
      }
    ],
    "conclusion": "Chaque modèle est comparé à des références naïves et n'est servi que s'il fait mieux. Toute la chaîne est tracée : données (empreinte SHA-256), code (version, archive), modèle (registre MLflow) et prévisions (PostgreSQL)."
  },
  "schemas": [
    {
      "id": "donnees", "hauteur": 700,
      "direction": "TB",
      "ligne": "parcours",
      "titre": "Parcours des données",
      "legende": "Cylindres : stockages. Pointillés : traces et retour arrière automatique.",
      "noeuds": [
        {"id": "binance", "label": "Binance\narchives mensuelles + API REST", "type": "externe"},
        {"id": "ingest", "label": "ingest-candles\nCHECKSUM, contrôles qualité,\nbougies interrompues écartées"},
        {"id": "parquet", "label": "Parquet\nhistorique depuis 2022-01", "type": "stockage"},
        {"id": "candles", "label": "market.candles\nbougies récentes", "type": "stockage"},
        {"id": "batches", "label": "tracing.ingestion_batches", "type": "stockage"},
        {"id": "features", "label": "features\nrendements, volatilités,\ncontexte marché, calendrier"},
        {"id": "train", "label": "train-volatility\nwalk-forward + test final"},
        {"id": "mlflow", "label": "MLflow\nruns, artefacts, registre", "type": "stockage"},
        {"id": "predict", "label": "predict-volatility\nchampion + challenger"},
        {"id": "predictions", "label": "tracing.predictions", "type": "stockage"},
        {"id": "feedback", "label": "feedback-volatility\nQLIKE à horizon clôturé"},
        {"id": "health", "label": "tracing.feedback\ntracing.model_health", "type": "stockage"},
        {"id": "api", "label": "API FastAPI"},
        {"id": "grafana", "label": "Grafana"}
      ],
      "liens": [
        {"de": "binance", "vers": "ingest"},
        {"de": "ingest", "vers": "parquet"},
        {"de": "ingest", "vers": "candles"},
